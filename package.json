{
  "name": "palimpsest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx server/cli.ts serve --port 4318",
    "build": "tsc -b && vite build && node scripts/build.mjs",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc -b",
    "start": "node dist/cli.mjs serve",
    "install:local": "node scripts/install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "diff": "^8.0.2",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "description": "A local skill library for Claude and Codex with package comparisons, shared links, and backups.",
  "license": "MIT",
  "author": "Maximilian Bülowius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MBuelowius/palimpsest.git"
  },
  "bugs": {
    "url": "https://github.com/MBuelowius/palimpsest/issues"
  },
  "homepage": "https://github.com/MBuelowius/palimpsest#readme",
  "engines": {
    "node": ">=24 <25"
  }
}
